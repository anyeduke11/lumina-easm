# EASM 服务脚本可选 env 覆盖（复制为 easm.env 使用；easm.env 已 gitignore，建议 0600）。
# 用法：cp scripts/easm.env.example scripts/easm.env && 按需取消注释。
# 纪律：密钥只放本文件（不落代码/仓库）；脚本是 env 覆盖面，缺省值见 scripts/service.sh。

# —— AI 面（ENH-03：三件套同设才装配，缺失=mm:analyze / shadow with_ai 返 501 诚实边界）——
# EASM_AI_API_KEY=sk-your-key-here（真实密钥只写入 easm.env，勿提交）
# EASM_AI_MODEL=sensenova-6.8-flash-lite
# EASM_AI_BASE_URL=https://token.sensenova.cn/v1

# —— Temporal（worker 需要；server 未设=进程内同步执行回退）——
# EASM_TEMPORAL_HOST=127.0.0.1:7233

# —— 服务端口 / dev 令牌（对外环境必须 OIDC/ENH-07，dev 令牌仅内网）——
# EASM_PORT=8087
# EASM_SINGLE_USER=1
# EASM_DEV_TOKENS=tok-admin:R7:*
# 高危动作确认（默认开启；scan:port/scan:dir/notices 需 X-EASM-Confirmation。
# 仅演示/回归确需降级时显式设 0——生产与演练保持默认）
# EASM_REQUIRE_CONFIRMATION=0

# —— 身份：生产 OIDC；应急 break-glass；passkey step-up ——
# EASM_OIDC_ISSUER=https://idp.example/realms/easm
# EASM_OIDC_AUDIENCE=easm
# EASM_OIDC_JWKS_URL=https://idp.example/realms/easm/protocol/openid-connect/certs
# EASM_BREAKGLASS_HASH=  # go run ./platform/services/cmd/breakglass -init
# EASM_PASSKEY_PUBLIC_KEY=  # go run ./platform/services/cmd/passkey -init -out passkey-private.pem

# —— 外部 ASM feed（可选；POST {seeds} -> {observations:[...]}）——
# EASM_ASM_URL=https://asm.example/api/observations
# EASM_ASM_TOKEN=
# EASM_CLOUD_URL=https://cloud.example/api/observations
# EASM_CLOUD_TOKEN=

# —— 资产衰减（Phase 3；retire 必须大于 stale）——
# EASM_ASSET_STALE_AFTER=720h
# EASM_ASSET_RETIRE_AFTER=2160h

# —— 评测门禁阈值（5 段：f1,误报,κ,幻觉,最小样本；非法装载即拒）——
# EASM_EVAL_THRESHOLDS=0.90,0.10,0.60,0.00,30

# —— 评分四因子权重/阈值（和=100%；待 G8-01 定稿后仅换配置）——
# EASM_SCORE_WEIGHTS=30,30,25,15
# EASM_SCORE_THRESHOLDS=70,40
